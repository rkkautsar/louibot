{
  "name": "louibot",
  "version": "0.1.0",
  "description": "A local-first GitHub issue implementer that opens draft pull requests.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rkkautsar/louibot.git"
  },
  "bugs": {
    "url": "https://github.com/rkkautsar/louibot/issues"
  },
  "homepage": "https://github.com/rkkautsar/louibot#readme",
  "type": "module",
  "bin": {
    "louibot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx src/cli.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.0",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/openai": "^1.6.2",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "langchain": "^1.5.17",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
